# Sao chép thành .env (không commit .env) rồi điền giá trị thật.

# Mật khẩu PostgreSQL (dùng cho cả app và backup). BẮT BUỘC điền; để trống thì compose từ chối chạy.
# Gợi ý: openssl rand -base64 32
POSTGRES_PASSWORD=

# Khóa ký JWT, base64, >= 256 bit. Sinh bằng:
#   openssl rand -base64 64 | tr -d '\n'
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# Sao chép backup ra ngoài VPS (tùy chọn nhưng nên bật), dạng user@host:/duong/dan
# Để trống = không sao chép; giao diện Quản trị sẽ hiện cảnh báo.
BACKUP_OFFSITE_RSYNC=

# Đẩy backup (đã mã hóa) lên Google Drive bằng rclone, dạng remote:thu-muc, vd gdrive:HRM-backup.
# NÊN cấu hình trên web: Cài đặt → Sao lưu (khi đã có cấu hình web thì biến này và BACKUP_AGE_RECIPIENT không còn được dùng).
# Cách thủ công cần ops/backup/rclone/rclone.conf + file JSON service account (README, "Cấu hình thủ công").
# Có thể bật cùng lúc với BACKUP_OFFSITE_RSYNC. Để trống = không dùng.
BACKUP_OFFSITE_RCLONE=

# Khóa mã hóa cũng NÊN tạo trên web (Cài đặt → Sao lưu); cấu hình web được ưu tiên hơn biến này.
# Public key age để MÃ HÓA bản backup trước khi đẩy ra ngoài VPS (bắt buộc nếu dùng BACKUP_OFFSITE_RSYNC/RCLONE).
# Để trống = KHÔNG đẩy ra ngoài (không để bản chưa mã hóa rời VPS), giao diện Quản trị hiện cảnh báo kèm lý do.
# Tạo cặp khóa trên MÁY CỦA BẠN (không phải VPS):  age-keygen -o hrm-backup-key.txt
#   -> dòng "# public key: age1..." là giá trị điền vào đây; file hrm-backup-key.txt (private key) cất giữ an toàn
#      ngoài VPS, mất file này thì không giải mã được bản backup ngoài VPS. Nhiều khóa: cách nhau bởi dấu phẩy.
# Bản backup trên VPS (volume backups, 14 bản) không mã hóa; ngoài VPS giữ 30 bản mới nhất (BACKUP_OFFSITE_KEEP).
BACKUP_AGE_RECIPIENT=

# Thư mục chứa khóa SSH (id_ed25519, tùy chọn known_hosts) gắn chỉ đọc vào container backup.
# BACKUP_SSH_DIR=./ops/backup/ssh

# Thư mục chứa rclone.conf + service-account.json gắn chỉ đọc vào container backup.
# BACKUP_RCLONE_DIR=./ops/backup/rclone

# Tên miền cho Caddy (chỉ khi chạy với --profile proxy).
DOMAIN=

# Địa chỉ:cổng publish của app (mặc định 127.0.0.1:8080; đổi nếu cổng bận).
# APP_BIND=127.0.0.1:8080

# Mật khẩu mặc định của tài khoản mới (tên đăng nhập = số CCCD). Người dùng phải đổi mật khẩu ở lần đăng nhập đầu.
# Để trống = dùng giá trị đặt ở Cài đặt → Tài khoản, nếu chưa đặt thì Doit@2024. Nếu điền: ít nhất 8 ký tự.
APPLICATION_ACCOUNT_DEFAULT_PASSWORD=

# Thông tin công ty (phiếu lương, báo cáo nhân sự, hợp đồng, quyết định cử nhân sự) giờ sửa trên web: Cài đặt → Công ty.
# Ba biến dưới đây CHỈ là giá trị khởi tạo lần đầu (khi cơ sở dữ liệu chưa có cài đặt công ty); sau đó đổi .env không còn tác dụng.
# Người đại diện ký văn bản: điền ở đây hoặc sau này trong Cài đặt → Công ty; phải có trước khi sinh hợp đồng, quyết định
# (để trống thì hệ thống báo thiếu "Người đại diện công ty").
APPLICATION_COMPANY_REPRESENTATIVE_NAME=
# Chức vụ người ký (trống = Giám đốc).
APPLICATION_COMPANY_REPRESENTATIVE_TITLE=
# Tên công ty (trống = CÔNG TY TNHH CÔNG NGHỆ VÀ TRUYỀN THÔNG DO IT).
APPLICATION_COMPANY_NAME=

# ---------------------------------------------------------------------------
# Gửi thư (TÙY CHỌN). Dùng để gửi link đặt lại mật khẩu khi người dùng yêu cầu qua email.
# Cách khuyên dùng: Quản trị cấu hình email trên web ở Cài đặt → Email (không cần sửa .env, không cần khởi động lại).
# Các biến SPRING_MAIL_* / JHIPSTER_MAIL_FROM dưới đây chỉ dùng khi chưa cấu hình email trên giao diện.
# Để trống tất cả = không gửi thư được; khi đó Quản trị vào Quản trị → Tài khoản → chọn tài khoản → "Đặt mật khẩu".
# Ví dụ Gmail/Google Workspace: SPRING_MAIL_HOST=smtp.gmail.com, SPRING_MAIL_PORT=587,
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true, SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true, mật khẩu ứng dụng.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# true khi máy chủ thư yêu cầu đăng nhập (có USERNAME/PASSWORD).
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=
# Địa chỉ người gửi, vd hrm@congty.vn
JHIPSTER_MAIL_FROM=
# Địa chỉ truy cập ứng dụng, dùng cho link trong thư, vd https://hrm.congty.vn
JHIPSTER_MAIL_BASE_URL=
# Khóa mã hóa mật khẩu email nhập trên giao diện (Cài đặt → Email), ít nhất 16 ký tự.
# Sinh bằng: openssl rand -base64 32   (đổi khóa thì phải nhập lại mật khẩu email trên giao diện)
APPLICATION_MAIL_SECRET_KEY=
