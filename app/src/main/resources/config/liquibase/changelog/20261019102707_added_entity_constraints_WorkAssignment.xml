    <!--
        Added the constraints for entity WorkAssignment.
    -->
    <changeSet id="20261019102707-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="employee_id"
                                 baseTableName="work_assignment"
                                 constraintName="fk_work_assignment__employee_id"
