<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Mức luật định theo ngày hiệu lực (thay cho các mốc cố định trong code lõi). Chỉ thêm mốc mới; mốc mới phải có hiệu lực
        sau kỳ lương đã duyệt gần nhất. payroll_rule_setting (1 dòng): tháng cuối cùng đã biết chắc luật.
    -->
    <changeSet id="20261022000100-1" author="doit">
        <createTable tableName="payroll_rule_milestone">
            <column name="id" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="effective_from" type="varchar(7)"><constraints nullable="false"/></column>
            <column name="personal_deduction" type="numeric(15,0)"><constraints nullable="false"/></column>
            <column name="dependant_deduction" type="numeric(15,0)"><constraints nullable="false"/></column>
            <column name="social_insurance_cap" type="numeric(15,0)"><constraints nullable="false"/></column>
            <column name="unemployment_insurance_cap" type="numeric(15,0)"><constraints nullable="false"/></column>
            <column name="legal_basis" type="varchar(500)"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_at" type="${datetimeType}"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="payroll_rule_bracket">
            <column name="id" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="milestone_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_payroll_rule_bracket__milestone_id" referencedTableName="payroll_rule_milestone" referencedColumnNames="id"/>
            </column>
            <column name="position" type="int"><constraints nullable="false"/></column>
            <column name="up_to" type="numeric(15,0)"/>
            <column name="rate" type="numeric(5,4)"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="payroll_rule_setting">
            <column name="id" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="known_through" type="varchar(7)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="20261022000100-2" author="doit">
        <createTable tableName="payroll_rule_milestone_aud">
            <column name="id" type="bigint"><constraints nullable="false"/></column>
            <column name="rev" type="bigint"><constraints nullable="false"/></column>
            <column name="revtype" type="smallint"/>
            <column name="effective_from" type="varchar(7)"/>
            <column name="personal_deduction" type="numeric(15,0)"/>
            <column name="dependant_deduction" type="numeric(15,0)"/>
            <column name="social_insurance_cap" type="numeric(15,0)"/>
            <column name="unemployment_insurance_cap" type="numeric(15,0)"/>
            <column name="legal_basis" type="varchar(500)"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_at" type="${datetimeType}"/>
        </createTable>
        <addPrimaryKey tableName="payroll_rule_milestone_aud" columnNames="id, rev" constraintName="pk_payroll_rule_milestone_aud"/>
        <addForeignKeyConstraint baseTableName="payroll_rule_milestone_aud" baseColumnNames="rev" constraintName="fk_payroll_rule_milestone_aud_rev"
                                 referencedTableName="audit_revision" referencedColumnNames="id"/>
        <createTable tableName="payroll_rule_bracket_aud">
            <column name="id" type="bigint"><constraints nullable="false"/></column>
            <column name="rev" type="bigint"><constraints nullable="false"/></column>
            <column name="revtype" type="smallint"/>
            <column name="milestone_id" type="bigint"/>
            <column name="position" type="int"/>
            <column name="up_to" type="numeric(15,0)"/>
            <column name="rate" type="numeric(5,4)"/>
        </createTable>
        <addPrimaryKey tableName="payroll_rule_bracket_aud" columnNames="id, rev" constraintName="pk_payroll_rule_bracket_aud"/>
        <addForeignKeyConstraint baseTableName="payroll_rule_bracket_aud" baseColumnNames="rev" constraintName="fk_payroll_rule_bracket_aud_rev"
                                 referencedTableName="audit_revision" referencedColumnNames="id"/>
        <createTable tableName="payroll_rule_setting_aud">
            <column name="id" type="bigint"><constraints nullable="false"/></column>
            <column name="rev" type="bigint"><constraints nullable="false"/></column>
            <column name="revtype" type="smallint"/>
            <column name="known_through" type="varchar(7)"/>
        </createTable>
        <addPrimaryKey tableName="payroll_rule_setting_aud" columnNames="id, rev" constraintName="pk_payroll_rule_setting_aud"/>
        <addForeignKeyConstraint baseTableName="payroll_rule_setting_aud" baseColumnNames="rev" constraintName="fk_payroll_rule_setting_aud_rev"
                                 referencedTableName="audit_revision" referencedColumnNames="id"/>
    </changeSet>

