<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Xóa hẳn nhân viên (chỉ login admin): dòng lương của các kỳ được giữ nguyên số tiền, file_code, file_name; chỉ liên kết
        employee_id thành trống. payroll_line_aud.employee_id vốn cho phép trống.
    -->
    <changeSet id="20261030000300-1" author="doit">
        <dropNotNullConstraint tableName="payroll_line" columnName="employee_id" columnDataType="bigint"/>
    </changeSet>

    <!-- Nhật ký xóa hẳn: chỉ thêm dòng; không FK, không CCCD/tài khoản ngân hàng/địa chỉ. -->
    <changeSet id="20261030000300-2" author="doit">
        <createTable tableName="employee_deletion_log">
            <column name="id" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="deleted_at" type="${datetimeType}"><constraints nullable="false"/></column>
            <column name="deleted_by" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="reason" type="varchar(500)"><constraints nullable="false"/></column>
            <column name="employee_code" type="varchar(50)"/>
            <column name="employee_name" type="varchar(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
