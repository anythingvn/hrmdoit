<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Đơn làm thêm giờ: giờ, hệ số (150/200/300) và cờ giờ đêm tính lúc đăng ký; người duyệt tính lúc gửi và lưu trên đơn
        (approver_employee_id null khi BGĐ / Quản trị). Giờ nghỉ bù cộng vào quỹ NGHI_BU khi hoàn tất (dòng sổ LAM_THEM, liên kết
        OVERTIME:id). Lịch sử ở overtime_request_aud.
    -->
    <changeSet id="20261028000100-1" author="doit">
        <createTable tableName="overtime_request">
            <column name="id" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="employee_id" type="bigint"><constraints nullable="false"/></column>
            <column name="work_date" type="date"><constraints nullable="false"/></column>
            <column name="start_time" type="time"><constraints nullable="false"/></column>
            <column name="end_time" type="time"><constraints nullable="false"/></column>
            <column name="planned_hours" type="numeric(5,2)"><constraints nullable="false"/></column>
            <column name="actual_hours" type="numeric(5,2)"/>
            <column name="rate" type="int"><constraints nullable="false"/></column>
            <column name="night" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="content" type="varchar(1000)"/>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="compensation" type="varchar(10)"/>
            <column name="approver_kind" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="approver_employee_id" type="bigint"/>
            <column name="decided_by" type="varchar(50)"/>
            <column name="decided_at" type="timestamp"/>
            <column name="decision_note" type="varchar(500)"/>
            <column name="on_behalf" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="confirmed_at" type="timestamp"/>
            <column name="auto_confirmed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp"><constraints nullable="false"/></column>
            <column name="submitted_by" type="varchar(50)"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="overtime_request" baseColumnNames="employee_id" constraintName="fk_overtime_request__employee_id"
                                 referencedTableName="employee" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="overtime_request" baseColumnNames="approver_employee_id" constraintName="fk_overtime_request__approver_employee_id"
                                 referencedTableName="employee" referencedColumnNames="id"/>
        <createIndex tableName="overtime_request" indexName="ix_overtime_request__employee">
            <column name="employee_id"/>
            <column name="work_date"/>
        </createIndex>
        <createIndex tableName="overtime_request" indexName="ix_overtime_request__status">
            <column name="status"/>
            <column name="work_date"/>
        </createIndex>

        <createTable tableName="overtime_request_aud">
            <column name="id" type="bigint"><constraints nullable="false"/></column>
            <column name="rev" type="bigint"><constraints nullable="false"/></column>
            <column name="revtype" type="smallint"/>
            <column name="employee_id" type="bigint"/>
            <column name="work_date" type="date"/>
            <column name="start_time" type="time"/>
            <column name="end_time" type="time"/>
            <column name="planned_hours" type="numeric(5,2)"/>
            <column name="actual_hours" type="numeric(5,2)"/>
            <column name="rate" type="int"/>
            <column name="night" type="boolean"/>
            <column name="content" type="varchar(1000)"/>
            <column name="status" type="varchar(20)"/>
            <column name="compensation" type="varchar(10)"/>
            <column name="approver_kind" type="varchar(20)"/>
            <column name="approver_employee_id" type="bigint"/>
            <column name="decided_by" type="varchar(50)"/>
            <column name="decided_at" type="timestamp"/>
            <column name="decision_note" type="varchar(500)"/>
            <column name="on_behalf" type="boolean"/>
            <column name="confirmed_at" type="timestamp"/>
            <column name="auto_confirmed" type="boolean"/>
            <column name="created_at" type="timestamp"/>
            <column name="submitted_by" type="varchar(50)"/>
        </createTable>
        <addPrimaryKey tableName="overtime_request_aud" columnNames="id, rev" constraintName="pk_overtime_request_aud"/>
        <addForeignKeyConstraint baseTableName="overtime_request_aud" baseColumnNames="rev" constraintName="fk_overtime_request_aud_rev"
                                 referencedTableName="audit_revision" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
