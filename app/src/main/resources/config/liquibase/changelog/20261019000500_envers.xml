        <addPrimaryKey tableName="salary_change_aud" columnNames="id, rev" constraintName="pk_salary_change_aud"/>
        <addForeignKeyConstraint baseTableName="salary_change_aud" baseColumnNames="rev" constraintName="fk_salary_change_aud_rev"
