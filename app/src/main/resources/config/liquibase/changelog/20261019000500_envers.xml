    <changeSet id="20261019000500-7" author="doit">
        <createTable tableName="employee_document_aud">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="rev" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="revtype" type="smallint"/>
            <column name="file_name" type="varchar(255)"/>
            <column name="content_type" type="varchar(100)"/>
            <column name="size_bytes" type="bigint"/>
            <column name="storage_path" type="varchar(500)"/>
            <column name="uploaded_by" type="varchar(50)"/>
            <column name="uploaded_at" type="${datetimeType}"/>
